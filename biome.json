{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/shared/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "Only extension modules may import vscode."
                },
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "**/application/**",
                      "**/infrastructure/**",
                      "**/extension/**",
                      "**/providers/**",
                      "**/webview/**"
                    ],
                    "message": "Keep imports within the permitted source layers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/webview/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "Only extension modules may import vscode."
                },
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "**/application/**",
                      "**/infrastructure/**",
                      "**/extension/**",
                      "**/providers/**"
                    ],
                    "message": "Keep imports within the permitted source layers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/application/**",
        "src/infrastructure/**",
        "src/providers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "Only extension modules may import vscode."
                },
                "patterns": [
                  {
                    "group": [
                      "**/extension/**"
                    ],
                    "message": "Keep imports within the permitted source layers."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
