{
  "name": "agent-workspace",
  "displayName": "Agent Workspace",
  "description": "A local workspace for Codex and Claude sessions, plans, and review.",
  "version": "0.5.0",
  "publisher": "local-workspace",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Agent execution and workspace documents require workspace trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "agentWorkspace.open",
        "title": "Agent Workspace: Open Workspace",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentWorkspace.openInEditor",
        "title": "Agent Workspace: Open in Editor",
        "icon": "$(link-external)"
      },
      {
        "command": "agentWorkspace.new",
        "title": "Agent Workspace: New Thread",
        "icon": "$(add)"
      },
      {
        "command": "agentWorkspace.refresh",
        "title": "Agent Workspace: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentWorkspace",
          "title": "Agent Workspace",
          "icon": "media/workspace.svg",
          "when": "agentWorkspace.noSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agentWorkspaceSecondary",
          "title": "Agent Workspace",
          "icon": "media/workspace.svg",
          "when": "!agentWorkspace.noSecondarySidebar"
        }
      ]
    },
    "views": {
      "agentWorkspaceSecondary": [
        {
          "type": "webview",
          "id": "agentWorkspace.chat",
          "name": "Agent Workspace",
          "when": "!agentWorkspace.noSecondarySidebar"
        }
      ],
      "agentWorkspace": [
        {
          "type": "webview",
          "id": "agentWorkspace.chatFallback",
          "name": "Agent Workspace",
          "when": "agentWorkspace.noSecondarySidebar"
        }
      ]
    },
    "configuration": {
      "title": "Agent Workspace",
      "properties": {
        "agentWorkspace.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex executable name or absolute path."
        },
        "agentWorkspace.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Claude Code executable name or absolute path."
        },
        "agentWorkspace.claud2Path": {
          "type": "string",
          "default": "claud2",
          "description": "Second Claude Code executable or wrapper path. Shell aliases and command arguments are not executable paths."
        },
        "agentWorkspace.claud2ConfigDir": {
          "type": "string",
          "default": "~/.claude-account2",
          "description": "Used when no second Claude executable is found: runs Claude Code with this folder as CLAUDE_CONFIG_DIR, the same as an alias like claude2='CLAUDE_CONFIG_DIR=~/.claude-account2 claude'."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "agentWorkspace.openInEditor",
          "when": "view == agentWorkspace.chat || view == agentWorkspace.chatFallback",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "agentWorkspace.open",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository",
    "preview": "node scripts/preview.mjs",
    "smoke": "node --import tsx scripts/smoke.ts",
    "smoke:delegate": "node --import tsx scripts/smoke-delegate.ts",
    "test:ui": "node --import tsx scripts/ui-check.ts",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.68.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "1.4.0",
    "shiki": "4.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "private": true
}
