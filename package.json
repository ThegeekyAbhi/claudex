{
  "name": "claudex",
  "displayName": "Claudex",
  "description": "Codex and Claude Code together. Local threads, plans, approvals, and diffs in VS Code.",
  "version": "0.7.0",
  "publisher": "nerdyabhi",
  "icon": "media/claudex-icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "keywords": ["codex", "claude", "claude-code", "agents", "chat", "planning"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ThegeekyAbhi/vcpm.git"
  },
  "homepage": "https://github.com/ThegeekyAbhi/vcpm#readme",
  "bugs": {
    "url": "https://github.com/ThegeekyAbhi/vcpm/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Agent execution and workspace documents require workspace trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "agentWorkspace.open",
        "title": "Claudex: Open Workspace",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentWorkspace.openInEditor",
        "title": "Claudex: Open in Editor",
        "icon": "$(link-external)"
      },
      {
        "command": "agentWorkspace.new",
        "title": "Claudex: New Thread",
        "icon": "$(add)"
      },
      {
        "command": "agentWorkspace.refresh",
        "title": "Claudex: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentWorkspace",
          "title": "Claudex",
          "icon": "media/mascot/icon.png",
          "when": "agentWorkspace.noSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agentWorkspaceSecondary",
          "title": "Claudex",
          "icon": "media/mascot/icon.png",
          "when": "!agentWorkspace.noSecondarySidebar"
        }
      ]
    },
    "views": {
      "agentWorkspaceSecondary": [
        {
          "type": "webview",
          "id": "agentWorkspace.chat",
          "name": "Claudex",
          "icon": "media/mascot/icon.png",
          "when": "!agentWorkspace.noSecondarySidebar"
        }
      ],
      "agentWorkspace": [
        {
          "type": "webview",
          "id": "agentWorkspace.chatFallback",
          "name": "Claudex",
          "icon": "media/mascot/icon.png",
          "when": "agentWorkspace.noSecondarySidebar"
        }
      ]
    },
    "configuration": {
      "title": "Claudex",
      "properties": {
        "agentWorkspace.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex executable name or absolute path."
        },
        "agentWorkspace.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Claude Code executable name or absolute path."
        },
        "agentWorkspace.claud2Path": {
          "type": "string",
          "default": "claud2",
          "description": "Second Claude Code executable or wrapper path. Shell aliases and command arguments are not executable paths."
        },
        "agentWorkspace.claud2ConfigDir": {
          "type": "string",
          "default": "~/.claude-account2",
          "description": "Used when no second Claude executable is found: runs Claude Code with this folder as CLAUDE_CONFIG_DIR, the same as an alias like claude2='CLAUDE_CONFIG_DIR=~/.claude-account2 claude'."
        },
        "agentWorkspace.guidedPlanning": {
          "type": "boolean",
          "default": true,
          "description": "Ask agents for clear, evidence-based plans, useful diagrams, and acceptance tests."
        },
        "agentWorkspace.richExplanations": {
          "type": "boolean",
          "default": true,
          "description": "In Ask mode, ask agents to add a sandboxed visual when a picture explains something better than prose."
        },
        "agentWorkspace.crossAgentContext": {
          "type": "string",
          "enum": [
            "recent",
            "full",
            "off"
          ],
          "enumDescriptions": [
            "Send the goal and as much recent history as fits in about 10k tokens.",
            "Send the goal and as much history as fits in about 75k tokens.",
            "Send nothing: switching agent moves only your draft, as before."
          ],
          "default": "recent",
          "markdownDescription": "When you continue a thread in another agent, how much of its history goes with your next message, as a chip you can open or remove. Going back to an agent sends only what's new since. Hidden reasoning and approvals never transfer."
        },
        "agentWorkspace.appearance": {
          "type": "string",
          "enum": [
            "cursor",
            "editor"
          ],
          "enumDescriptions": [
            "Cursor's dark colors on any dark theme. Light and high contrast themes still follow the editor.",
            "Follow the active editor theme everywhere."
          ],
          "default": "cursor",
          "description": "Colors for Claudex."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "agentWorkspace.openInEditor",
          "when": "view == agentWorkspace.chat || view == agentWorkspace.chatFallback",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "agentWorkspace.open",
          "group": "navigation"
        }
      ]
    },
    "markdown.previewScripts": [
      "./dist/markdown-preview.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "package": "pnpm build && node scripts/package.mjs",
    "preview": "node scripts/preview.mjs",
    "smoke": "node --import tsx scripts/smoke.ts",
    "smoke:delegate": "node --import tsx scripts/smoke-delegate.ts",
    "test:ui": "node --import tsx scripts/ui-check.ts",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "mermaid": "^12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "1.4.0",
    "shiki": "4.6.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "private": true
}
